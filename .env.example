# ---------- 运行 ----------
ENVIRONMENT=dev
DEBUG=false
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Shanghai

# ---------- 数据库 ----------
# 生产（docker-compose 内）: postgresql+asyncpg://hr:hr@postgres:5432/hr_robot
# 本地/测试: sqlite+aiosqlite:///./var/hr_robot.db
DATABASE_URL=sqlite+aiosqlite:///./var/hr_robot.db
DB_ECHO=false

# ---------- 飞书自建应用 ----------
# mock = 不发真实请求，只落库留痕（无 app_id 时的默认值，见 DECISIONS.md）
# live = 走 lark_oapi 官方 SDK
FEISHU_MODE=mock
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ---------- LLM（OpenAI 兼容接口） ----------
# auto = 有 OPENAI_API_KEY 才调，否则走确定性规则抽取
# live = 强制调用；off = 只用规则抽取
LLM_MODE=auto
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

# ---------- HR 邮箱 ----------
# mock = 只写 var/outbox/mail/*.eml；入站从 var/mock_inbox/*.eml 读取
MAIL_MODE=mock
HR_MAILBOX=hr@example.com
HR_SENDER_NAME=星野科技 HR
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_INBOX=INBOX
IMAP_POLL_LIMIT=30

# ---------- 调度 ----------
SCHEDULER_ENABLED=true
# 留空则读 config/positions.yaml 的 schedule.cron
SCHEDULE_CRON=0 9 * * *
# 入站邮件轮询间隔（秒），<=0 关闭
INBOUND_POLL_SECONDS=300
