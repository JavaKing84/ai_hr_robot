# ---------- 运行 ----------
ENVIRONMENT=dev
DEBUG=false
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Shanghai

# ---------- 数据库 ----------
# 生产（docker-compose 内）: postgresql+asyncpg://hr:hr@postgres:5432/hr_robot
# 本地开发/调试（默认）: postgresql+asyncpg://hr:hr@localhost:5432/hr_robot
#   （PG 启动方式见 docs/database-setup.md）
# 测试（Pytest）: 同样使用 PostgreSQL——tests/conftest.py 自动派生 <库名>_test 并建库/清库，
#   无需在此配置；可用 TEST_DATABASE_URL 指定独立测试库，TEST_PG_AUTOSTART=0 关闭自动拉起 docker
DATABASE_URL=postgresql+asyncpg://hr:hr@localhost:5432/hr_robot
DB_ECHO=false

# ---------- 飞书自建应用 ----------
# mock = 不发真实请求，只落库留痕（无 app_id 时的默认值，见 DECISIONS.md）
# live = 走 lark_oapi 官方 SDK
FEISHU_MODE=mock
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ---------- 飞书推送渠道 ----------
# group = 出站消息统一发到群机器人 webhook（推荐，HR/主管都在群里）
# user  = 按 positions.yaml 的 supervisor_open_id 逐个私聊（旧行为）
FEISHU_PUSH_TARGET=group
# 群自定义机器人 webhook（文本消息走这里；不需要 app 凭证）
FEISHU_WEBHOOK_URL=
# 群 chat_id（oc_ 开头）：webhook 不能传文件，简历压缩包要用应用身份发到群里。
# 需要应用开通 im:resource:upload 与 im:message:send_as_bot
FEISHU_CHAT_ID=
# 群消息要 @ 谁（open_id，逗号分隔），留空则不 @
FEISHU_MENTION_OPEN_IDS=

# ---------- LLM（litellm 统一网关，多供应商 + 自动降级） ----------
# auto = 配了供应商链或 OPENAI_API_KEY 才调，否则走确定性规则抽取
# live = 强制调用；off = 只用规则抽取（离线闭环，不依赖任何 key）
LLM_MODE=auto

# 主模型：litellm 用「模型名前缀」识别供应商（gpt-* / deepseek/* / claude-* / gemini/* ...）
# 下面这块是本项目 2026-11-05 **真机联调通过**的组合（DeepSeek 官方，国内直连，实测 0.6~0.9s 返回合法 JSON）
LLM_MODEL=deepseek/deepseek-chat

# ⚠️ OPENAI_BASE_URL 必须与上面 LLM_MODEL 的供应商一致：
#    client/llm.py 显式把 api_base 传给 litellm，指向 OpenAI 官方却用 DeepSeek 模型会直接 502/401。
#    DeepSeek: https://api.deepseek.com/v1     OpenAI: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# key 统一写在 OPENAI_API_KEY（Settings 只读这个字段；写 DEEPSEEK_API_KEY 不会被读取）
#    DeepSeek key: sk-<32 位十六进制>（platform.deepseek.com → API keys）
#    OpenAI   key: sk-proj-<48 位字母数字>
OPENAI_API_KEY=

# 【推荐】多供应商链：JSON 数组，顺序＝降级顺序，每家自带 api_base/api_key。
# 全挂 → 静默退回「确定性规则抽取 + 规则打分」，整轮任务不会中断。
# 例：
# LLM_PROVIDERS=[{"name":"学院-qwen3.8-27b","model":"openai/qwen3.8-27b","api_base":"http://x.x.x.x:11434/v1","api_key":"k"},{"name":"deepseek兜底","model":"deepseek/deepseek-chat","api_base":"https://api.deepseek.com/v1","api_key":"sk-xxx"}]
LLM_PROVIDERS=
# 是否开启大模型深度解析（维度分/亮点/风险/面试追问点）。true=开启
LLM_DEEP_ANALYSIS=true

# 降级候选模型（逗号分隔，可空）：主模型调用失败/超时后按顺序依次尝试
# 注意：fallback 与主模型共用同一个 api_base，因此只能填**同一供应商**的模型
# 示例：LLM_FALLBACK_MODELS=deepseek/deepseek-reasoner
# 全空 = 主模型失败即回落「确定性规则抽取」（离线闭环始终可用）
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=45

# ---------- HR 邮箱 ----------
# mock = 只写 var/outbox/mail/*.eml；入站从 var/mock_inbox/*.eml 读取
MAIL_MODE=mock
HR_MAILBOX=hr@example.com
HR_SENDER_NAME=星野科技 HR
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_INBOX=INBOX
IMAP_POLL_LIMIT=30

# ---------- 调度 ----------
SCHEDULER_ENABLED=true
# 留空则读 config/positions.yaml 的 schedule.cron
SCHEDULE_CRON=0 9 * * *
# 入站邮件轮询间隔（秒），<=0 关闭
INBOUND_POLL_SECONDS=300
